# Copy to .env and fill in. Never commit .env.
# Database (used by docker compose for the db and api services)
POSTGRES_USER=edupulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=edupulse

# JWT signing secret (required): at least 32 random bytes; the API refuses to start otherwise, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EDUPULSE_JWT_SECRET=

# Comma-separated list of allowed browser origins
EDUPULSE_CORS_ORIGINS=http://localhost:8088,http://localhost:5173

# Password given to every synthetic demo account by the seed script (demo only). Required:
# the seed refuses an empty/default value; 12+ characters with upper, lower case and a digit.
EDUPULSE_DEMO_PASSWORD=

# For running the API outside Docker against the compose database
EDUPULSE_DATABASE_URL=postgresql+psycopg://edupulse:change-me-local-only@127.0.0.1:5432/edupulse

# Refresh-token cookie is Secure by default (works on http://localhost). Set false only for
# plain-HTTP access from other hosts. Enable HSTS when serving over HTTPS.
# EDUPULSE_COOKIE_SECURE=true
# EDUPULSE_HSTS=false

# Host ports published by docker compose (bound to 127.0.0.1 only)
EDUPULSE_WEB_PORT=8088
EDUPULSE_API_PORT=8000
EDUPULSE_DB_PORT=5432

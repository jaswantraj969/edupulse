# Production / public-demo settings for deploy/docker-compose.prod.yml.
# Create deploy/.env with ./make_env.sh (generates the secrets) or copy this file and fill it in.
# deploy/.env is git-ignored. Never commit real values.

# The public name of the server (a domain or a free DNS name pointing at the server's IP).
EDUPULSE_DOMAIN=
# E-mail for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=

# Database password (random, 24+ characters).
POSTGRES_PASSWORD=
# JWT signing secret (random, 32+ bytes).
EDUPULSE_JWT_SECRET=

# Synthetic demo data. The demo password is shown on the login page while EDUPULSE_DEMO_MODE
# is true; 12+ characters with upper-case, lower-case and a digit.
EDUPULSE_DEMO_MODE=true
EDUPULSE_DEMO_PASSWORD=

# Public demo: blocks deletes, CSV import, account approval and admin creation, shows a banner,
# and resets the database every EDUPULSE_DEMO_RESET_HOURS. Set false for a private installation
# with real data (and then also set EDUPULSE_DEMO_MODE=false and EDUPULSE_DEMO_PASSWORD=).
EDUPULSE_PUBLIC_DEMO=true
EDUPULSE_DEMO_RESET_HOURS=6

# Days of daily database backups to keep in the db-backups volume.
BACKUP_KEEP_DAYS=14
